(define-derived-mode nm-mode f90-mode "NONMEM mode"
  "A simple derived mode for NONMEM from f90-mode."
  ;; :syntax-table f90-mode-syntax-table
  (setq-local fill-column 80)
  (setq-local comment-start ";")
  (setq-local comment-end "")
  (setq-local comment-start-skip ";+\\s-*")
  (modify-syntax-entry ?_ "w")
  (modify-syntax-entry ?! ".")    ;; remove old comment char `!` by setting to punctuation
  (modify-syntax-entry ?\; "<")   ;; define `;` as comment start
  (modify-syntax-entry ?\n ">")   ;; newline ends the comment
  (modify-syntax-entry ?\" "\""))  ;; double quotes as string delimiters

(font-lock-add-keywords 'nm-mode nm-mode-font-lock-keywords)

(add-to-list 'auto-mode-alist '("\\.ctl\\'" . nm-mode))
(add-to-list 'auto-mode-alist '("\\.mod\\'" . nm-mode))
