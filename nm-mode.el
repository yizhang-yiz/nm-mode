;; nm-mode is a minimalist majfor mode for NONMEM

(defface nm-mode-ctl-record-face
  '((t (:foreground "dark red" :weight bold)))
  "Face for highlighting control record in nm-mode."
  :group 'nm-mode-faces)

(defface nm-mode-keyword-face
  '((t (:foreground "dark cyan")))
  "Face for highlighting keywords and options in nm-mode."
  :group 'nm-mode-faces)

(defface nm-mode-variable-face
  '((t (:foreground "systemIndigoColor" :weight bold)))
  "Face for highlighting buildin and common variables in nm-mode."
  :group 'nm-mode-faces)

